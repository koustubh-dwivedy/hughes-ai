    "description": "Terminal SSE event carrying the persisted assistant message and,\nwhen the agent emitted OpenUI Lang DSL, the validated payload (HUG-178\nPhase B). `openui` is None when the agent's `final_answer` did not\npopulate `openui_dsl`.",
    "properties": {
      "message": {
        "$ref": "#/$defs/ThreadMessage"
      },
      "openui": {
        "anyOf": [
          {
            "$ref": "#/$defs/OpenUIDslPayload"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "message"
    ],
    "title": "StreamFinal",
    "type": "object"
  },
  "StreamStep": {
    "description": "Intermediate SSE event: a single agent step or tool result.",
    "properties": {
      "args": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Args"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Name"
      },
      "result": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Result"
      },
      "step": {
        "title": "Step",
        "type": "integer"
      }
    },
    "required": [
      "step",
      "kind"
    ],
    "title": "StreamStep",
    "type": "object"
  },
  "StreamThinking": {
    "description": "SSE event carrying a single narration line for the Thinking box\n(HUG-202). The box shows ONE line at a time \u2014 each new event REPLACES\nthe previous line rather than appending. The full ordered history is\npreserved server-side as the `thinking_trace` and surfaced in the\nReferences modal once the turn completes.",
    "properties": {
      "line": {
        "title": "Line",
        "type": "string"
      },
      "step": {
        "title": "Step",
        "type": "integer"
      }
    },
    "required": [
      "step",
      "line"
    ],
    "title": "StreamThinking",
    "type": "object"
  },
  "StreamToken": {
    "description": "SSE event carrying a content delta for the assistant's\nstreaming summary (HUG-202 Phase 2). The frontend appends each\ndelta to the in-flight answer bubble's text. The full canonical\nsummary lands in the subsequent `final` event when the turn ends.",
    "properties": {
      "content_delta": {
        "title": "Content Delta",
        "type": "string"
      }
    },
    "required": [
      "content_delta"
    ],
    "title": "StreamToken",
    "type": "object"
  }
}
